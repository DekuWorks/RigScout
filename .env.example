# =============================================================================
# RigScout environment variables
# Copy to .env (never commit real secrets)
# Validate: ./scripts/validate-env.sh local
# =============================================================================

# -----------------------------------------------------------------------------
# LOCAL — Frontend (Vite). Public values only; prefix with VITE_.
# -----------------------------------------------------------------------------
# Supabase project URL (Settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key (safe for client; RLS still applies)
VITE_SUPABASE_ANON_KEY=your-anon-key

# FastAPI base URL (local dev; production Pages uses GitHub variable VITE_API_BASE_URL)
VITE_API_BASE_URL=http://localhost:8000

# Public site origin (custom domain)
VITE_SITE_URL=https://rigscout.co

# GitHub Pages base path. Use "/" for custom domain (rigscout.co); "/RigScout/" for project pages.
VITE_BASE_PATH=/

# Google OAuth — configure in Supabase Auth → Providers (NOT as VITE_*).
# Client ID is public; client secret stays only in Supabase / Google Cloud.
# See docs/AUTH_GOOGLE.md
# Callback URL: https://<project-ref>.supabase.co/auth/v1/callback
# Add https://rigscout.co/** to Supabase Auth → URL configuration.


# -----------------------------------------------------------------------------
# LOCAL — Backend (FastAPI / Python jobs). Server-only secrets.
# Production host (Railway): set the same names in the service Variables UI.
# See docs/API_HOSTING.md
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co

# Service role key — NEVER expose to the frontend
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional JWT secret if validating tokens server-side
SUPABASE_JWT_SECRET=your-jwt-secret

API_HOST=0.0.0.0
API_PORT=8000
# Include production origins when testing CORS against the live site
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://rigscout.co,https://www.rigscout.co
API_RATE_LIMIT_PER_MINUTE=60
ENVIRONMENT=development

# Email delivery — leave blank until configured
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@rigscout.co

# Token for POST /v1/jobs/* (evaluate-alerts, sync-prices)
# Also set as GitHub secret ALERT_JOB_TOKEN (same value) when the API is hosted
ALERT_JOB_TOKEN=

# -----------------------------------------------------------------------------
# Retailer APIs — leave blank until provisioned (see docs/RETAILER_ADAPTERS.md)
# Set the same names on Railway for production ingestion.
# -----------------------------------------------------------------------------
# Best Buy Remix (primary live path)
# Signup: https://developer.bestbuy.com/
# BEST_BUY_API_KEY=

# Amazon PA-API 5 (Associates). All three required. No scraping.
# Signup: https://affiliate-program.amazon.com/
# Note: PA-API 5 is deprecated in favour of Creators API — see RETAILER_ADAPTERS.md
# AMAZON_PAAPI_ACCESS_KEY=
# AMAZON_PAAPI_SECRET_KEY=
# AMAZON_PAAPI_PARTNER_TAG=

# Newegg Marketplace seller keys — do NOT unlock public catalog search (stub only)
# NEWEGG_API_KEY=
# NEWEGG_SELLER_ID=

# Micro Center — no public API; stub only (manual/CSV later)


# -----------------------------------------------------------------------------
# PRODUCTION — GitHub Actions (not loaded from this file)
# Secrets:  VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY,
#           SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, ALERT_JOB_TOKEN
# Vars:     VITE_BASE_PATH, VITE_SITE_URL, VITE_API_BASE_URL, API_BASE_URL
# Check:    ./scripts/validate-env.sh production-checklist
# -----------------------------------------------------------------------------

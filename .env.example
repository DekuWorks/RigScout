# =============================================================================
# RigScout environment variables
# Copy to .env (never commit real secrets)
# =============================================================================

# --- Frontend (Vite) — public values only; prefix with VITE_ ---
# Supabase project URL (Settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key (safe for client; RLS still applies)
VITE_SUPABASE_ANON_KEY=your-anon-key

# FastAPI base URL (local or deployed API)
VITE_API_BASE_URL=http://localhost:8000

# GitHub Pages base path. Use "/" for custom domain; "/RigScout/" for project pages.
VITE_BASE_PATH=/

# Optional: Google OAuth is configured in Supabase Dashboard, not here.
# Enable Google provider in Auth → Providers when credentials are ready.

# --- Backend (FastAPI / Python jobs) — server-only secrets ---
# Same Supabase URL as above
SUPABASE_URL=https://your-project.supabase.co

# Service role key — NEVER expose to the frontend
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional JWT secret if validating tokens server-side
SUPABASE_JWT_SECRET=your-jwt-secret

# API
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_RATE_LIMIT_PER_MINUTE=60
ENVIRONMENT=development

# Email delivery (Phase 5) — leave blank until configured
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@rigscout.local

# Retailer credentials (Phase 3+) — label integrations that need approval
# RETAILER_API_KEY_EXAMPLE=
